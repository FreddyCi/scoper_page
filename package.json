{
  "name": "browser-doc-agent-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "copy:duckdb": "node scripts/copy-duckdb-assets.mjs",
    "copy:liteparse": "node scripts/copy-liteparse-assets.mjs",
    "copy:tesseract": "node scripts/copy-tesseract-assets.mjs",
    "copy:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "copy:samples": "node scripts/generate-sample-pdfs.mjs",
    "copy:assets": "pnpm copy:duckdb && pnpm copy:liteparse && pnpm copy:tesseract && pnpm copy:pdfjs && pnpm copy:samples",
    "dev": "pnpm copy:assets && vite",
    "build": "pnpm copy:assets && tsc -b && vite build && pnpm prepare:hosting && pnpm build:check && pnpm verify:build",
    "build:check": "node scripts/check-bundle-size.mjs",
    "verify:build": "node scripts/verify-build-assets.mjs",
    "preview:smoke": "node scripts/preview-smoke.mjs",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "qa:automated": "node scripts/run-qa-automation.mjs",
    "qa:proposal": "node scripts/run-proposal-qa-static.mjs && pnpm qa:automated",
    "qa:drawing-markup": "node scripts/run-drawing-markup-qa-static.mjs",
    "qa:compliance-matrix": "node scripts/run-compliance-matrix-qa-static.mjs",
    "qa:company-profile": "node scripts/run-company-profile-qa-static.mjs",
    "qa:scout": "node scripts/run-scout-qa-static.mjs",
    "qa:v1": "node scripts/run-qa-v1-automation.mjs",
    "prepare:hosting": "node scripts/prepare-static-hosting.mjs",
    "deploy:scout": "pnpm build && pnpm exec wrangler deploy",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "pnpm copy:assets"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@llamaindex/liteparse-wasm": "^2.10.0",
    "@shadcn/react": "^0.3.0",
    "bitgpu": "^0.19.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.530",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.15.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "wrangler": "^4.14.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild",
      "sharp"
    ]
  }
}
